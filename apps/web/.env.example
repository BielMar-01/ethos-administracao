# Server-only API origin; never an administrative DB URL or browser token.
ETHOS_API_ORIGIN=http://127.0.0.1:3333
ETHOS_WEB_ORIGIN=http://localhost:3000
# Local preparation requires no public HTTPS. Keep API bound to loopback.
# Future production: exact HTTPS origins; ETHOS_WEB_ORIGIN must match API WEB_ORIGIN.
# No NEXT_PUBLIC_* database credentials, authentication keys or tokens.
