{
  "name": "@ethos/api",
  "version": "0.1.0",
  "description": "API oficial do SaaS Ethos Administração",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "test:auth": "node --test tests/auth.integration.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@ethos/database": "workspace:*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "nodemailer": "^10.2.0",
    "otpauth": "^9.5.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
