# Secrets must be generated independently per environment, never committed.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3333
WEB_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Exact roles provisioned AFTER approval by packages/database/scripts/prepare-auth-runtime.sql.
# Supabase session pooler (5432): username ROLE.PROJECT_REF, password URL-encoded.
# AUTH_IDENTITY_DATABASE_URL uses ethos_auth_runtime; DATABASE_URL uses ethos_tenant_runtime.
# Never put DIRECT_DATABASE_URL or the administrative credential in the API environment.
AUTH_IDENTITY_DATABASE_URL=
DATABASE_URL=
# Independently generated secret (at least 32 characters), different per environment.
AUTH_COOKIE_SECRET=
# 32 random bytes encoded as base64. Rotating requires a controlled MFA/outbox migration.
AUTH_ENCRYPTION_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# SMTP TLS: 465 implicit TLS or 587 STARTTLS; certificate verification remains enabled.
# Never use real recipients in isolated tests. No SMTP delivery is required for DB activation.
# Local preparation: NODE_ENV=development and localhost origins; remote PostgreSQL still uses TLS.
# Future production: NODE_ENV=production, exact HTTPS WEB_ORIGIN/CORS_ORIGINS,
# Secure __Host- cookies. Do not set cookie Domain. No public deploy is needed now.
# Access token 5 min, refresh 7 days, absolute session 30 days are code constants, not env knobs.
# MFA uses AUTH_ENCRYPTION_KEY; TOTP parameters and platform MFA requirement are code policy.
# Only isolated loopback development/test databases, forbidden in production.
ETHOS_LOCAL_DATABASE=0
