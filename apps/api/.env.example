# Secrets must be generated independently per environment, never committed.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3333
WEB_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Exact roles provisioned by packages/database/scripts/provision-auth.sql.
AUTH_IDENTITY_DATABASE_URL=
DATABASE_URL=
AUTH_COOKIE_SECRET=
# 32 random bytes encoded as base64. Rotating requires a controlled MFA/outbox migration.
AUTH_ENCRYPTION_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Only isolated loopback development/test databases, forbidden in production.
ETHOS_LOCAL_DATABASE=0
