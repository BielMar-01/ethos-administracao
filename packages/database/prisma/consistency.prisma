// Technical state; no request bodies, tokens or personal data are retained here.
model ResourceRevision {
  organizationId String @db.Uuid
  resource String @db.VarChar(80)
  recordId String @db.Uuid
  revision BigInt @default(1)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([organizationId, resource, recordId])
  @@schema("ethos_technical")
}

model MutationReceipt {
  organizationId String @db.Uuid
  membershipId String @db.Uuid
  operation String @db.VarChar(160)
  keyHash String @db.Char(64)
  inputHash String @db.Char(64)
  resource String @db.VarChar(80)
  recordId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  membership OrganizationMembership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([organizationId, membershipId, operation, keyHash])
  @@index([organizationId, createdAt])
  @@schema("ethos_technical")
}
