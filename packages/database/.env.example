# Copie para .env e preencha localmente. Nunca versione credenciais.
# Runtime: URL PostgreSQL com usuário, senha codificada e servidor do seu projeto.
# Operações tenant exigem role sem SUPERUSER/BYPASSRLS/ownership e contexto transacional.
# Não reutilizar a credencial administrativa de migrations na futura API de negócio.
DATABASE_URL=""
# Migrations: conexão direta ou pooler de SESSÃO (5432), nunca transacional (6543).
DIRECT_DATABASE_URL=""
# Audit/activation scripts only: project ref independently copied from the Supabase Dashboard.
# This is an identifier, not a password; do not infer it from the URL for activation approval.
EXPECTED_SUPABASE_PROJECT_REF=""
# Local disposable tests only. Keep 0 for every real Supabase connection.
ETHOS_LOCAL_DATABASE=0
# Direct IPv6 backup from Windows: absolute path to a PostgreSQL 17 pg_dump.exe.
# Docker Desktop bridge IPv6 was unavailable in this review; no automatic pooler fallback.
# Restore still uses an isolated local Docker container, without external networking.
PG_DUMP_PATH=""
PG_RESTORE_PATH=""
